# Copy this file to ".env" and fill in your key. NEVER commit the real .env.
#
# Get a free Gemini API key from Google AI Studio (no credit card needed):
#   https://aistudio.google.com/apikey

# Use the Gemini API (Google AI Studio) rather than Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=

# Optional: override the model (default is gemini-2.5-flash).
# MODEL=gemini-2.5-flash

# Optional: point the sanctions tool at the real OFAC list after downloading it.
# SANCTIONS_FILE=data/ofac_sdn.csv
